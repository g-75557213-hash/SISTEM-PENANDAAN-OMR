# GEMINI_API_KEY: Masukkan kunci API Gemini anda di sini.
# Boleh menggunakan satu kunci, berbilang kunci dipisahkan koma, atau GEMINI_API_KEY_1, GEMINI_API_KEY_2.
# Contoh: GEMINI_API_KEY="AIzaSy..."
GEMINI_API_KEY=""

# Pilihan: Berbilang kunci Gemini (dipisahkan koma):
# GEMINI_API_KEYS="AIzaSy...1,AIzaSy...2"

# Pilihan: Kunci bernombor:
# GEMINI_API_KEY_1="AIzaSy...1"
# GEMINI_API_KEY_2="AIzaSy...2"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=""
